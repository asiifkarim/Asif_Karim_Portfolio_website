# Production Environment Variables Template
# Copy this file to .env for local development
# For production, set these in your hosting platform (Railway/Render)

# Server Configuration
PORT=8000

# Security - CRITICAL: Generate a strong secret key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-secret-key-change-this-immediately

# CORS Configuration - Add your frontend domain
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-custom-domain.com

# GitHub Integration
GITHUB_USERNAME=asiifkarim

# Database Configuration (SQLite by default)
# For production with PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./portfolio.db

# Admin Configuration (Optional - for initial setup)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-this-password

# Application Settings
ENVIRONMENT=production
DEBUG=False

# Logging
LOG_LEVEL=INFO

# Rate Limiting (Optional)
# RATE_LIMIT_PER_MINUTE=60

# File Upload Settings
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,avif

# Session Settings
SESSION_TIMEOUT=3600  # 1 hour in seconds

# Email Configuration (Optional - for contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com
