{
  "version": 2,
  "name": "portfolio-frontend",
  "builds": [
    {
      "src": "frontend/src/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/src/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/src/index.html"
    },
    {
      "source": "/(.*).html",
      "destination": "/frontend/src/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
